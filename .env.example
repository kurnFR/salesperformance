# Copy to .env and fill in. Never commit .env (it is git-ignored).

# PostgreSQL (the existing staging database)
PG_HOST=
PG_PORT=
PG_DB=
PG_USER=
PG_PASSWORD=

# Optional, recommended later: a read-only user for the business tables.
# If left empty, PG_USER is used for both, and the app opens business-table sessions read-only.
# PG_RO_USER=
# PG_RO_PASSWORD=

# App-owned schema inside the same database (created by migrations, never inside dwh_prod).
# PG_APP_SCHEMA=app_config

# Encryption master key for saved AI API keys and MFA secrets: 32 random bytes, base64.
# The app refuses to start without it. Keep a secure backup separate from database backups.
APP_MASTER_KEY=

# Web server
# APP_PORT=3000
# APP_BASE_URL=
